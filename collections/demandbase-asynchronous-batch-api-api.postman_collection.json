                        "b2b",
                        "v1",
                        "job",
                        ":jobId"
                      ],
                      "variable": [
                        {
                          "key": "jobId"
                        }
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
