    {
      "name": "match",
      "item": [
        {
          "name": "job",
          "item": [
            {
              "name": "Match Companies and Contacts in Bulk",
              "id": "bd457708-4b7a-4b33-bb1f-c7e5090d10fe",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{bearerToken}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "text/plain"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "<string>"
                },
                "url": {
                  "raw": "https://uapi.demandbase.com/data/b2b/v1/match/job?jobName=<string>",
                  "protocol": "https",
                  "host": [
                    "uapi",
                    "demandbase",
                    "com"
                  ],
                  "path": [
                    "data",
                    "b2b",
                    "v1",
                    "match",
                    "job"
                  ],
                  "query": [
                    {
                      "description": "(Required) Job name for the match job",
                      "key": "jobName",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "Use this endpoint to enrich company and contact records in bulk using a CSV file upload. Each row in the file represents one enrichment request and must match the supported field structure. This endpoint supports up to 10,000 records per job.\n\n**CSV Results Format:**\nThe completed job will return a CSV file with the following structure:\n- Input columns from your uploaded CSV are preserved\n- Additional columns are added for matched company data (companyId, name, city, state, country, matchScore, etc.)\n- Additional columns are added for matched contact data (contactId, firstName, lastName, title, email, matchScore, etc.)\n- Multiple matches are returned as separate rows with the same input ID\n- If no matches are found, the row will contain only the input data with empty match columns"
              },
              "response": [
                {
                  "id": "f6533079-0e7f-427c-9312-5c455ba3daae",
                  "name": "Successful submission of match job\n\nResponse File (CSV Output)\nUpon job completion, the downloadable results file will include:\n| Field Name              | Description                                                             |\n| -----------------------",
                  "originalRequest": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "text/plain"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      },
