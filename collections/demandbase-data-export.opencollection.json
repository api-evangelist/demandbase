{
  "opencollection": "1.0.0",
  "info": {
    "name": "Data Export API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Get Fields",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Export fields",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://uapi.demandbase.com/data/export/v1/fields",
            "params": [
              {
                "name": "entityType",
                "value": "",
                "type": "query",
                "description": "Specifies the entity for which to retrieve available export fields."
              },
              {
                "name": "adReportType",
                "value": "",
                "type": "query",
                "description": "Specifies the adReportType for which to retrieve available export fields."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The Fields endpoint returns a list of all fields available for specific data export jobs.\nFor `campaign` and `creative` export jobs, the query parameter `adReportType` is required.\n"
        }
      ]
    },
    {
      "info": {
        "name": "Create Export Job",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create export job (Account, Opportunity, Person, Activity, Campaign, and Creative)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://uapi.demandbase.com/data/export/v1/job",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a data export job for any supported entity type."
        },
        {
          "info": {
            "name": "Create account list export job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://uapi.demandbase.com/data/export/v1/accountList/job",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create account list export job"
        },
        {
          "info": {
            "name": "Create person list export job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://uapi.demandbase.com/data/export/v1/personList/job",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create person list export job"
        }
      ]
    },
    {
      "info": {
        "name": "Get Job Details",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Returns a list of submitted export jobs.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://uapi.demandbase.com/data/export/v1/jobs",
            "params": [
              {
                "name": "entityType",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "perPage",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "jobStatus",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of submitted export jobs."
        },
        {
          "info": {
            "name": "Check status of a data export job",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://uapi.demandbase.com/data/export/v1/job/:jobId",
            "params": [
              {
                "name": "jobId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Poll this endpoint until jobStatus is terminal. accepted and processing are non-terminal; continue polling. finished and failed are terminal. A finished job includes its download URL; a failed job does not produce a result file."
        }
      ]
    },
    {
      "info": {
        "name": "Get Reference Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get available reference objects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://uapi.demandbase.com/data/export/v1/references",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get available reference objects"
        },
        {
          "info": {
            "name": "Get reference data fields for an object",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://uapi.demandbase.com/data/export/v1/reference/:object",
            "params": [
              {
                "name": "object",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get reference data fields for an object"
        }
      ]
    }
  ],
  "bundled": true
}