                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/v1/fields?entityType=opportunity&adReportType=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v1",
                    "fields"
                  ],
                  "query": [
                    {
                      "description": "(Required) Specifies the entity for which to retrieve available export fields.",
                      "key": "entityType",
                      "value": "opportunity"
                    },
                    {
                      "description": "Specifies the adReportType for which to retrieve available export fields.",
                      "key": "adReportType",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "The Fields endpoint returns a list of all fields available for specific data export jobs.\nFor `campaign` and `creative` export jobs, the query parameter `adReportType` is required."
