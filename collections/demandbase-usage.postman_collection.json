  "info": {
    "_postman_id": "6f01186a-08a2-4e19-b14d-d4cfb7273e1c",
    "name": "Usage API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "This API allows authenticated users to retrieve summary-level credit usage and entitlement data for a specified API product. It supports two billing models:\n\n- **Per Record:** Credits are deducted each time a record is returned.\n\n- **RUM (Record Under Management):** Credits are deducted once per unique record per entitlement period.\n\nContact Support:\n Name: Support\n Email: support@demandbase.com",
      "type": "text/plain"
    }
  }
