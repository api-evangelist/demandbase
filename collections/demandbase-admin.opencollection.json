{
  "opencollection": "1.0.0",
  "info": {
    "name": "Admin API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "User Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create new user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://uapi.demandbase.com/admin/v1/user",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "<div style=\"background:#FFFFFF; border-left:4px solid #3bb273; border-top:1px solid #000000;border-right:1px solid #000000;border-bottom:1px solid #000000; padding:10px 14px; border-radius:4px; margin-bottom:10px;\">\n<h3>Overview</h3><br>\nCreates a new <strong>user</strong> within your Demandbase account.\n</div>"
        },
        {
          "info": {
            "name": "Update users",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://uapi.demandbase.com/admin/v1/user",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "<div style=\"background:#FFFFFF; border-left:4px solid #3bb273; border-top:1px solid #000000;border-right:1px solid #000000;border-bottom:1px solid #000000; padding:10px 14px; border-radius:4px; margin-bottom:10px;\">\n<h3>Overview</h3><br>\nUpdates an existing <strong>user</strong> within your Demandbase account.\n</div>"
        },
        {
          "info": {
            "name": "Get list of users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://uapi.demandbase.com/admin/v1/users",
            "params": [
              {
                "name": "departments",
                "value": "",
                "type": "query",
                "description": "<div style=\"background:#FFFFFF; border-left:4px solid #3bb273; padding:10px 14px; border-radius:4px; margin-bottom:10px;\">comma separated list of departments<br><strong>Example:</strong> Marketing,Sales</div>"
              },
              {
                "name": "views",
                "value": "",
                "type": "query",
                "description": "<div style=\"background:#FFFFFF; border-left:4px solid #3bb273; padding:10px 14px; border-radius:4px; margin-bottom:10px;\">comma separated list of views<br><strong>Example:</strong> Standard View,Marketing View</div>"
              },
              {
                "name": "permissionSets",
                "value": "",
                "type": "query",
                "description": "<div style=\"background:#FFFFFF; border-left:4px solid #3bb273; padding:10px 14px; border-radius:4px; margin-bottom:10px;\">comma separated list of permission sets<br><strong>Example:</strong> General User,Admin</div>"
              },
              {
                "name": "workspaces",
                "value": "",
                "type": "query",
                "description": "<div style=\"background:#FFFFFF; border-left:4px solid #3bb273; padding:10px 14px; border-radius:4px; margin-bottom:10px;\">comma separated list of workspaces (if enabled)<br><strong>Example:</strong> global workspace</div>"
              },
              {
                "name": "pageNo",
                "value": "",
                "type": "query",
                "description": "<div style=\"background:#FFFFFF; border-left:4px solid #3bb273; padding:10px 14px; border-radius:4px; margin-bottom:10px;\"><strong>Default:</strong> 1<br><strong>Example:</strong> 5</div>"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "<div style=\"background:#FFFFFF; border-left:4px solid #3bb273; padding:10px 14px; border-radius:4px; margin-bottom:10px;\"><strong>Default:</strong> 25<br><strong>Example:</strong> 25<br><strong>Max:</strong> 100</div>"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "<div style=\"background:#FFFFFF; border-left:4px solid #3bb273; border-top:1px solid #000000;border-right:1px solid #000000;border-bottom:1px solid #000000; padding:10px 14px; border-radius:4px; margin-bottom:10px;\">\n<h3>Overview</h3><br>\nThis endpoint allows you to retrieve users with pagination (max pageSize 100) and filters for departments, views, permissionSets, and workspaces.\n</div>"
        },
        {
          "info": {
            "name": "Get a user by external id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://uapi.demandbase.com/admin/v1/user/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "<div style=\"background:#FFFFFF; border-left:4px solid #3bb273; padding:10px 14px; border-radius:4px; margin-bottom:10px;\">An external client defined identifier for the user (set when creating the user)<br><strong>Example:</strong> dcb34525-2baa-4f54-8c11-9e6175ecbc74</div>"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "<div style=\"background:#FFFFFF; border-left:4px solid #3bb273; border-top:1px solid #000000;border-right:1px solid #000000;border-bottom:1px solid #000000; padding:10px 14px; border-radius:4px; margin-bottom:10px;\">\n<h3>Overview</h3><br>\nThe Get Users By External ID API allows you to retrieve a specific user's data.\n</div>\n"
        },
        {
          "info": {
            "name": "Delete user using external user id",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://uapi.demandbase.com/admin/v1/user/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "<div style=\"background:#FFFFFF; border-left:4px solid #3bb273; padding:10px 14px; border-radius:4px; margin-bottom:10px;\">An external client defined identifier for the user (set when creating the user)<br><strong>Example:</strong> dcb34525-2baa-4f54-8c11-9e6175ecbc74</div>"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "<div style=\"background:#FFFFFF; border-left:4px solid #3bb273; border-top:1px solid #000000;border-right:1px solid #000000;border-bottom:1px solid #000000; padding:10px 14px; border-radius:4px; margin-bottom:10px;\">\n<h3>Overview</h3><br>\nDeletes an existing <strong>user</strong> from your Demandbase account.\n</div>"
        }
      ]
    }
  ],
  "bundled": true
}